CREATE PROCEDURE GetCustomerOrders(IN p_customer_id INT)
BEGIN
    SELECT
        o.order_id,
        r.restaurant_name,
        o.order_date,
        o.order_status,
        o.total_amount
    FROM orders o
    JOIN restaurants r
        ON o.restaurant_id = r.restaurant_id
